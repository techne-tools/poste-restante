# Poste Restante — public env template (NO SECRETS).
# Copy to .env.public and adjust. Secrets go in .env.enc (sops+age), not here.
#
# The two SECRET variables are read from the environment by deploy.sh:
#   POSTGRES_PASSWORD  — the shared-postgres superuser password (required,
#                        and the only way the house DB gets provisioned).
#   SMTP_OUTBOUND_URL  — optional; the outbound relay URL (smtp://user:pass@relay:587/).
#                        Unset/unempty → the seam ships dormant.

# ── the resident ──────────────────────────────────────────────────────────
# The house fails closed: 'none' is FORBIDDEN in production. 'basic' is the
# minimal resident door. 'oidc'/'both' come later (VoidAuth is resident).
AUTH_MODE=basic

# The address-space boundary (SPEC §5 #13).
HOUSE_DOMAIN=house

# How long a clause must stand unopposed before it settles (days).
BOOK_SETTLING_DAYS=7

# The gap pass heartbeat (ms). 0 disables the scheduler.
GAP_PASS_INTERVAL_MS=21600000

# ── the mailbox seam (SPEC §5 #12) ────────────────────────────────────────
# How often the sync drive re-mirrors provisioned mailboxes (ms). 0
# disables the scheduler — the house syncs on start and after every stored
# letter (the onStored hook). Per-resident IMAP URLs go in mailbox_accounts
# via `npm run mailbox:add`, never here.
MAILBOX_SYNC_INTERVAL_MS=0

# DEV-ONLY: accept the dev/homelab sidecar's self-signed cert for plaintext
# imap:// URLs. NEVER 1 in production — configure the CA via imaps://.
MAILBOX_TLS_INSECURE=0

# ── the spine ─────────────────────────────────────────────────────────────
# Database name the house provisions on shared-postgres (role: audiomuse).
POSTGRES_DB=poste_restante

# Semantic layer collection.
QDRANT_COLLECTION=letters

# The local brain.
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# ── the door (inbound SMTP) ───────────────────────────────────────────────
# Closed by default. 1 opens it on host 21027; the door refuses to run with
# AUTH_MODE=none (fail closed).
SMTP_ENABLED=0
