# Poste Restante — SECRETS seed (encrypt with sops, never commit plaintext).
#
#   cp .env.example .env.local        # seed
#   sops --encrypt .env.local > .env.enc
#   shred -u .env.local               # plaintext gone
#   sops .env.enc                     # edit secrets in place from then on
#
# These values are REQUIRED by deploy.sh / compose.yml. The public defaults
# live in .env.public; anything here overrides them.

# The shared-postgres password — REQUIRED. The house provisions its DB with
# it (role: audiomuse) and interpolates DATABASE_URL from it.
POSTGRES_PASSWORD=

# The MinIO raw-payload store keys — REQUIRED for enclosures (images, audio,
# other media attached to letters). Both must be set for the S3 store to
# activate (config.ts: minioEnabled). Match the values in
# containers/minio/.env.enc on the host.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# The outbound seam's relay (SPEC §5 #13). A mailto-style SMTP URL. Unset =
# the seam ships dormant; the house still stores everything, it just never
# relays externally. Example: smtp://user:pass@relay.example:587/
SMTP_OUTBOUND_URL=

# ── NO TS_AUTHKEY HERE ───────────────────────────────────────────────────
# Tailnet access is host-serve on the horza node (the sidecar collapse,
# 2026-08-23): the host's single Tailscale node already proxies
# https://poste-restante.mermaid-darter.ts.net:21016 → 127.0.0.1:21016.
# This stack runs no sidecar and needs no pre-auth key.
