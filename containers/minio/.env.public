# MinIO public defaults (committed). Non-secrets only.
# Secrets (MINIO_ROOT_PASSWORD) live in .env.enc (sops+age).

MINIO_ROOT_USER=poste_minio
# Console is off for alpha; the house's S3 API is the test surface.
MINIO_BROWSER=off
# Host API port (probed free 2026-09-07; 21018 is immich, 21019 vaultwarden).
MINIO_PORT_API=21035
MINIO_BUCKET=letters
