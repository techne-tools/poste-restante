# Stalwart sidecar — public env template (NO SECRETS).
#
# The sidecar carries ONE secret that matters at runtime: an IMAP listener
# binds all interfaces, but authentication is per-account and provisioned
# by the operator (a plan applied in recovery mode) — never from this file.
#
# The house reaches the sidecar by compose DNS with per-resident URLs
# stored in its own mailbox_accounts table (mailbox:add) — the secret
# lives there and in the STALWART plan, not here.

# The IMAP listener exposed on the host for operator / Spark checks.
# 21032 is calibre-web-automated on horza (recon 2026-09-07) — the sidecar
# publishes on 21037 (probed free 2026-09-07).
SIDECAR_IMAP_HOST_PORT=21037
