{
  "name": "@poste-restante/server",
  "version": "0.1.0",
  "private": true,
  "description": "Poste Restante — the archive spine. Postgres letters, qdrant semantic layer, ingestion pipeline, RRF retrieval.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations', 'dist/db/migrations', { recursive: true })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:integration": "NODE_ENV=test POSTE_RESTANTE_INTEGRATION=1 vitest run --no-file-parallelism",
    "migrate": "tsx src/db/migrate.ts",
    "auth:add": "tsx src/auth/cli.ts add",
    "auth:list": "tsx src/auth/cli.ts list",
    "auth:remove": "tsx src/auth/cli.ts remove",
    "invite:new": "tsx src/invites/cli.ts new",
    "serve": "tsx src/main.ts",
    "serve:mcp": "tsx src/mcp/main.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "hono": "^4.13.5",
    "jose": "^6.2.10",
    "pg": "^8.23.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
