{
  "name": "@poste-restante/server",
  "version": "0.1.0",
  "private": true,
  "description": "Poste Restante — the archive spine. Postgres letters, qdrant semantic layer, ingestion pipeline, RRF retrieval.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations', 'dist/db/migrations', { recursive: true })\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:integration": "NODE_ENV=test POSTE_RESTANTE_INTEGRATION=1 vitest run --no-file-parallelism",
    "migrate": "tsx src/db/migrate.ts",
    "auth:add": "tsx src/auth/cli.ts add",
    "auth:list": "tsx src/auth/cli.ts list",
    "auth:remove": "tsx src/auth/cli.ts remove",
    "mailbox:add": "tsx src/bridge/mailbox-cli.ts add",
    "mailbox:list": "tsx src/bridge/mailbox-cli.ts list",
    "mailbox:remove": "tsx src/bridge/mailbox-cli.ts remove",
    "invite:new": "tsx src/invites/cli.ts new",
    "integration:add": "tsx src/integrations/cli.ts add",
    "integration:list": "tsx src/integrations/cli.ts list",
    "integration:grant": "tsx src/integrations/cli.ts grant",
    "integration:revoke": "tsx src/integrations/cli.ts revoke",
    "pub:door": "tsx src/pub/cli.ts",
    "serve": "tsx src/main.ts",
    "serve:mcp": "tsx src/mcp/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "age-encryption": "^0.3.1",
    "hono": "^4.13.5",
    "imapflow": "^1.7.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.10",
    "mailparser": "^3.9.20",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "smtp-server": "^3.19.7",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
